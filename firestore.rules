rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /languages/{languageId} {
      allow read: if resource.data.visibility == 'public';
      allow write: if false;
    }

    match /words/{wordId} {
      allow read: if resource.data.visibility == 'public';
      allow write: if false;
    }

    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
